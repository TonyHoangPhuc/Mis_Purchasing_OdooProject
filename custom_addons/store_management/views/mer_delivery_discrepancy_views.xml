<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mer_excess_receipt_list" model="ir.ui.view">
        <field name="name">mer.excess.receipt.list</field>
        <field name="model">mer.excess.receipt</field>
        <field name="arch" type="xml">
            <list string="Báo cáo nhận dư hàng" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="date_report" string="Ngày ghi nhận"/>
                <field name="picking_id" optional="show"/>
                <field name="origin_request_id" string="PR gốc" optional="show"/>
                <field name="source_route_label" string="Luồng hàng" optional="show"/>
                <field name="handling_status" string="Tình trạng xử lý" optional="show"/>
                <field name="recovery_picking_id" string="Phiếu thu hồi" optional="show"/>
                <field name="display_store_name" string="Cửa hàng" optional="show"/>
                <field name="product_id" optional="show"/>
                <field name="expected_qty" string="SL hệ thống" sum="Tổng dự kiến"/>
                <field name="actual_qty" string="SL thực tế" sum="Tổng thực tế"/>
                <field name="discrepancy_qty" sum="Tổng dư" decoration-danger="discrepancy_qty > 0" decoration-bf="discrepancy_qty > 0"/>
                <field name="status_badge" widget="badge"
                    decoration-info="status_badge == 'new'"
                    decoration-success="status_badge == 'done'"
                    decoration-danger="status_badge == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_mer_excess_receipt_form" model="ir.ui.view">
        <field name="name">mer.excess.receipt.form</field>
        <field name="model">mer.excess.receipt</field>
        <field name="arch" type="xml">
            <form string="Báo cáo nhận dư hàng">
                <header>
                    <button name="action_submit" string="Gửi Merchandise" type="object" class="oe_highlight" invisible="state != 'draft'" groups="store_management.group_store_user"/>
                    
                    <button name="action_merchandise_approve" string="Phê duyệt" type="object" class="oe_highlight" 
                            invisible="context.get('from_store_menu') or state != 'reported'" groups="merchandise_management.group_merchandise_user"/>
                    
                    <button name="action_create_recovery_picking" string="Tạo đơn thu hồi" type="object" class="oe_highlight" 
                            invisible="state not in ['reported', 'approved']" groups="merchandise_management.group_merchandise_user"/>
                    
                    <button name="action_done" string="Xác nhận Kho đã nhận hàng" type="object" class="oe_highlight" 
                            invisible="context.get('from_store_menu') or context.get('from_merchandise_menu') or state != 'returning'" groups="warehouse_management.group_receiving_qc_user"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="draft,reported,approved,returning,done,cancel"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Mã báo cáo" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="Mới"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Tham chiếu" name="reference">
                            <field name="date_report" string="Ngày ghi nhận" readonly="1"/>
                            <field name="display_store_name" string="Cửa hàng" readonly="1"/>
                            <field name="create_uid" string="Người báo cáo" readonly="1"/>
                            <field name="picking_id" options="{'no_open': False}" readonly="1"/>
                        </group>
                        <group string="Theo dõi xử lý" name="tracking">
                            <field name="origin_request_id" string="PR gốc" readonly="1"/>
                            <field name="source_route_label" readonly="1"/>
                            <field name="handling_status" readonly="1"/>
                            <field name="recovery_picking_id" string="Phiếu thu hồi" readonly="1" invisible="not recovery_picking_id"/>
                        </group>
                    </group>
                    <group string="Chi tiết sai lệch">
                        <group>
                            <field name="product_id" options="{'no_open': True}" readonly="1"/>
                            <field name="expected_qty" string="SL hệ thống" readonly="1"/>
                        </group>
                        <group>
                            <field name="actual_qty" string="SL thực tế" readonly="1"/>
                            <field name="discrepancy_qty" string="SL dư" readonly="1"/>
                        </group>
                    </group>
                    <group invisible="not line_ids">
                        <field name="line_ids" nolabel="1" readonly="1">
                            <list create="0" delete="0" edit="0" open_form_view="0">
                                <field name="lot_id" optional="show"/>
                                <field name="expected_qty" string="SL hệ thống" sum="Tổng hệ thống"/>
                                <field name="actual_qty" string="SL thực tế" sum="Tổng thực tế"/>
                                <field name="discrepancy_qty" string="SL dư" sum="Tổng dư"/>
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Phương án giải quyết" name="recovery">
                            <group>
                                <group>
                                    <field name="central_stock_adjusted" readonly="1"/>
                                    <field name="source_location_id" readonly="1"/>
                                    <field name="holding_location_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="notes" placeholder="Nhập ghi chú tại đây..." readonly="state == 'done'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="action_mer_excess_receipt" model="ir.actions.act_window">
        <field name="name">Báo cáo nhận dư hàng</field>
        <field name="res_model">mer.excess.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mer_excess_receipt_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có báo cáo nhận dư hàng nào.
            </p>
        </field>
    </record>

    <record id="action_store_excess_receipt_to_submit" model="ir.actions.act_window">
        <field name="name">Báo cáo nhận dư hàng</field>
        <field name="res_model">mer.excess.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mer_excess_receipt_list"/>
        <field name="domain">[('state', '=', 'draft'), ('store_id', '!=', False)]</field>
        <field name="context">{'group_by': 'picking_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có báo cáo nhận dư hàng cần gửi Merchandise.
            </p>
        </field>
    </record>

    <record id="action_merchandise_excess_receipt_to_process" model="ir.actions.act_window">
        <field name="name">Báo cáo nhận dư hàng</field>
        <field name="res_model">mer.excess.receipt</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_mer_excess_receipt_list"/>
        <field name="domain">[('state', 'in', ['reported', 'approved'])]</field>
        <field name="context">{'group_by': 'picking_id'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Chưa có báo cáo nhận dư hàng cần Merchandise xử lý.
            </p>
        </field>
    </record>

    <record id="action_mer_excess_receipt_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mer_excess_receipt_form"/>
        <field name="act_window_id" ref="action_mer_excess_receipt"/>
    </record>

    <menuitem
        id="menu_mer_excess_receipt"
        name="Báo cáo nhận dư hàng"
        parent="store_management.menu_store_receipts_pending"
        action="action_store_excess_receipt_to_submit"
        sequence="20"
    />

    <!-- Menu Merchandise được quản lý tập trung tại warehouse_management_integration_views.xml -->
</odoo>
